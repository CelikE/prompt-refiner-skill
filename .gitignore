# The plugin manifests must be committed, even when a global gitignore
# excludes .claude-plugin/.
!.claude-plugin/
!.claude-plugin/**

# Eval run output (reports, JSON, transcripts)
evals/results/

# Session transcripts that the eval command writes into the case folders of
# cases that replay an earlier conversation. Only history.jsonl is a source file.
evals/*/*.jsonl
!evals/*/history.jsonl

# Python
__pycache__/
*.pyc

# OS and editors
.DS_Store
.idea/
.vscode/
